<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">

  <userData>
    <property name="gravity" type="vector" data="0 -9.81 0"/>
  </userData>

  <environment>
    <colourAmbient r="0.4" g="0.4" b="0.4"/>
  </environment>

  <parametricSurfaces>
    <parametricSurface name="Cylinder"  uResolution="96" vResolution="48">
      <uRange min="0" max="6.283185307" join="true"/>
      <vRange min="-0.3" max="0" join="false"/>
      <param name="R" value="0.005"/>
      <point  x="R*cos(u)" y="R*sin(u)" z="v"/>
      <normal x="cos(u)"   y="sin(u)"   z="0"/>
    </parametricSurface>

    <parametricSurface name="Sphere" uResolution="96" vResolution="48">
      <uRange min="0" max="3.141592654" join="false"/>
      <vRange min="0" max="6.283185307" join="true"/>
      <param name="R" value="0.1"/>
      <point  x="R*sin(u)*cos(v)" y="R*sin(u)*sin(v)" z="R*cos(u)"/>
      <normal x="sin(u)*cos(v)"   y="sin(u)*sin(v)"   z="cos(u)"/>
    </parametricSurface>
    
    <parametricSurface name="Torus" uResolution="96" vResolution="48">
      <uRange min="0" max="6.283185307" join="true"/>
      <vRange min="0" max="6.283185307" join="true"/>
      <param name="R" value="0.1"/>
      <param name="r" value="0.03"/>

      <point
        x="(R + r*cos(v))*cos(u)"
        y="(R + r*cos(v))*sin(u)"
        z="r*sin(v)"
      />

      <normal
        x="cos(v)*cos(u)"
        y="cos(v)*sin(u)"
        z="sin(v)"
      />
    </parametricSurface>

    <parametricSurface name="TrefoilKnot" uResolution="200" vResolution="32">
      <uRange min="0" max="6.283185307" join="true"/>
      <vRange min="0" max="6.283185307" join="true"/>
      <param name="r" value="0.03"/>

      <point
        x="0.1*(sin(u) + 2*sin(2*u)) + r*( cos(v)*(sin(u) - 4*sin(2*u))/sqrt(17 + 8*cos(3*u)) + sin(v)*3*cos(3*u)*(cos(u) + 4*cos(2*u))/(sqrt(17 + 8*cos(3*u))*sqrt(17 + 8*cos(3*u) + 9*cos(3*u)*cos(3*u))) )"
        y="0.1*(cos(u) - 2*cos(2*u)) + r*( cos(v)*(cos(u) + 4*cos(2*u))/sqrt(17 + 8*cos(3*u)) + sin(v)*3*cos(3*u)*(4*sin(2*u) - sin(u))/(sqrt(17 + 8*cos(3*u))*sqrt(17 + 8*cos(3*u) + 9*cos(3*u)*cos(3*u))) )"
        z="-0.1*sin(3*u) + r*sin(v)*sqrt(17 + 8*cos(3*u))/sqrt(17 + 8*cos(3*u) + 9*cos(3*u)*cos(3*u))"
      />

      <normal
        x="cos(v)*(sin(u) - 4*sin(2*u))/sqrt(17 + 8*cos(3*u)) + sin(v)*3*cos(3*u)*(cos(u) + 4*cos(2*u))/(sqrt(17 + 8*cos(3*u))*sqrt(17 + 8*cos(3*u) + 9*cos(3*u)*cos(3*u)))"
        y="cos(v)*(cos(u) + 4*cos(2*u))/sqrt(17 + 8*cos(3*u)) + sin(v)*3*cos(3*u)*(4*sin(2*u) - sin(u))/(sqrt(17 + 8*cos(3*u))*sqrt(17 + 8*cos(3*u) + 9*cos(3*u)*cos(3*u)))"
        z="sin(v)*sqrt(17 + 8*cos(3*u))/sqrt(17 + 8*cos(3*u) + 9*cos(3*u)*cos(3*u))"
      />
    </parametricSurface>
    
  </parametricSurfaces>


  <nodes>
    <node name="Trefoil">
      <position x="-0.5" y="2.5" z="-3"/>
      <parametricSurface ref="TrefoilKnot" material="Cannon"/>
      <userData>
        <property name="collider" type="string" data="sphere"/>
        <property name="mass" type="float" data="1"/>
        <property name="restitution" type="float" data="1.0"/>
        <property name="friction" type="float" data="0.3"/>
        <property name="rolling_friction" type="float" data="0.01"/>
        <property name="spinning_friction" type="float" data="0.1"/>
        <property name="linear_damping" type="float" data="0.05"/>
        <property name="angular_damping" type="float" data="0.1"/>
      </userData>
    </node>
  
    <node name="CannonBall">
      <position x="0.5" y="1.0" z="-3"/>
      <parametricSurface ref="Sphere" material="Cannon"/>
      <userData>
        <property name="collider" type="string" data="sphere"/>
        <property name="mass" type="float" data="1"/>
        <property name="restitution" type="float" data="1.0"/>
        <property name="friction" type="float" data="0.3"/>
        <property name="rolling_friction" type="float" data="0.01"/>
        <property name="spinning_friction" type="float" data="0.1"/>
        <property name="linear_damping" type="float" data="0.05"/>
        <property name="angular_damping" type="float" data="0.1"/>
      </userData>
    </node>

    <node name="CannonTorus">
      <position x="8" y="1" z="-6"/>
      <parametricSurface ref="Torus" material="Cannon"/>
      <userData>
        <property name="collider" type="string" data="hull"/>
        <property name="mass" type="float" data="1"/>
        <property name="restitution" type="float" data="0.6"/>
        <property name="friction" type="float" data="0.6"/>
      </userData>
    </node>

    <node name="CannonHammer">
      <position x="-2" y="1" z="-5"/>
      <rotation qw="0.7071" qx="0.7071" qy="0" qz="0"/>
      <scale x="0.1" y="0.1" z="0.1"/>
      <entity meshFile="hammer.mesh" material="hammer.objDefaultMaterial"/>
      <userData>
        <property name="collider" type="string" data="box"/>
        <property name="mass" type="float" data="1"/>
        <property name="restitution" type="float" data="0.5"/>
        <property name="friction" type="float" data="0.6"/>
      </userData>
    </node>
    
    <node name="Homer">
      <position x="3" y="1" z="-5"/>
      <scale x="2" y="2" z="2"/>
      <entity name="test" meshFile="homer.obj" material="cannon"/>
      <userData>
        <property name="collider" type="string" data="hull"/>
        <property name="mass" type="float" data="1"/>
        <property name="restitution" type="float" data="0.5"/>
        <property name="friction" type="float" data="0.6"/>
        <property name="rolling_friction" type="float" data="0.01"/>
        <property name="spinning_friction" type="float" data="0.1"/>
        <property name="linear_damping" type="float" data="0.05"/>
        <property name="angular_damping" type="float" data="0.1"/>
      </userData>
    </node>
    
    

    <node name="Player" >
      <position x="0" y="0" z="1.7" />
      <camera fov="0.785398163" name="Player" projectionType="perspective" >
        <clipping far="10000" near="0.01" />
      </camera>

      <node name="Cannon">
        <position x="0" y="-0.05" z="0"/>
        <parametricSurface ref="Cylinder" material="Cannon"/>
        
        <node name = "LightNode">
          <position x="0" y="0" z="-0.3"/>
          <light name="Flashlight" type="spot" castShadows="false">
            <colourDiffuse r="1" g="1" b="1"/>
            <colourSpecular r="0.5" g="0.5" b="0.5"/>      
            <lightRange inner="0.12" outer="0.35" falloff="0.5"/>
            <lightAttenuation range="30" constant="1" linear="0" quadratic="0.01"/>
          </light>
        </node>

      </node>


    </node>

    <node name="Ground">
      <plane
          name="GroundPlane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Ground"
          >
        <normal x="0" y="1" z="0"/>
        <upVector x="0" y="0" z="-1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Ceiling">
      <position x="0" y="5" z="0"/>
      <plane
          name="CeilingPlane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Ceiling"
          >
        <normal x="0" y="-1" z="0"/>
        <upVector x="0" y="0" z="1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Wall_1">
      <position x="-10" y="0" z="0"/>
      <plane
          name="Wall_1_Plane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Wall"
          >
        <normal x="1" y="0" z="0"/>
        <upVector x="0" y="-1" z="0"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Wall_2">
      <position x="10" y="0" z="0"/>
      <plane
          name="Wall_2_Plane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Wall"
          >
        <normal x="-1" y="0" z="0"/>
        <upVector x="0" y="1" z="0"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Wall_3">
      <position x="0" y="0" z="-10"/>
      <plane
          name="Wall_3_Plane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Wall"
          >
        <normal x="0" y="0" z="1"/>
        <upVector x="1" y="0" z="0"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Wall_4">
      <position x="0" y="0" z="10"/>
      <plane
          name="Wall_4_Plane" distance="0" width="20" height="20"
          xSegments="20" ySegments="20" numTexCoordSets="1"
          uTile="4" vTile="4" hasNormals="true" material="Wall"
          >
        <normal x="0" y="0" z="-1"/>
        <upVector x="-1" y="0" z="0"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

  </nodes>
</scene>

